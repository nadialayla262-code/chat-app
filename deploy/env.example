# Settings for the spine and the seats on your own box. Read by the systemd units.
# Prefix CXI_. Change a value, then: systemctl restart cxi-spine cxi-homei cxi-handi
CXI_PB_URL=http://127.0.0.1:8090
CXI_DESK_OWNERS=you@example.com
# Sign-up needs this code once it is set. Set it before the address is public.
CXI_SIGNUP_CODE=
# The superuser you create on first visit to /_/ . Handi needs it for "@handi find" and the backup needs it to prove a restore.
CXI_SUPERUSER_EMAIL=
CXI_SUPERUSER_PASSWORD=
# The local model, if installed on this box (install.sh --with-ollama). Leave as is otherwise.
CXI_OLLAMA_HOST=http://127.0.0.1:11434
CXI_CHAT_MODEL=qwen3:4b
CXI_EMBED_MODEL=qwen3-embedding:0.6b
